<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Capa de vídeo -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capa de imágenes (dos vistas para hacer fundido entre ellas) -->
    <FrameLayout
        android:id="@+id/image_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/image_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Pantalla de espera / mensajes -->
    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="48dp"
        android:text="@string/buscando"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <!-- Aviso pequeño abajo a la izquierda -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="32dp"
        android:background="#B0000000"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
